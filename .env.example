# Base local predeterminada: crea pasajes.db en la raíz del proyecto.
DATABASE_URL=sqlite:///./pasajes.db
# URL incluida dentro del QR. Puede quedarse así para una demostración local.
APP_BASE_URL=http://127.0.0.1:8000
# Nunca suba este archivo con valores reales. Genere una clave aleatoria para producción.
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_MAPS_API_KEY=
# Se crea el primer administrador únicamente si ambas variables están configuradas.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-this-before-running

# Alternativa futura con PostgreSQL (requiere instalar psycopg):
# DATABASE_URL=postgresql+psycopg://sabana_user:sabana_password@localhost:5432/sabana_pasajes
