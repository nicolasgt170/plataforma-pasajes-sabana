# Base local predeterminada: crea pasajes.db en la raíz del proyecto.
DATABASE_URL=sqlite:///./pasajes.db
# URL incluida dentro del QR. Puede quedarse así para una demostración local.
APP_BASE_URL=http://127.0.0.1:8000

